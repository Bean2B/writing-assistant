{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing Assistant transport request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "kind",
    "request",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "const": "writing-assistant-request/1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "enum": [
        "writing",
        "world-action"
      ]
    },
    "request": {
      "type": "string",
      "maxLength": 1048576,
      "x-maxUtf8Bytes": 1048576
    },
    "materials": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "purpose"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "purpose": {
            "enum": [
              "current-writing",
              "world-projection",
              "actor-projection"
            ]
          },
          "role": {
            "enum": [
              "request-material",
              "prior-prose",
              "current-draft",
              "feedback",
              "scene-projection"
            ]
          },
          "source_kind": {
            "enum": [
              "user-supplied",
              "producer-output",
              "record-version",
              "sandbox-projection",
              "synthetic",
              "unknown"
            ]
          },
          "feedback_target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "sha256"],
            "properties": {
              "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "description": "Exact current-draft transport reference. Allowed only on writing feedback; required and exact-match checked for revision before resolving content."
          }
        },
        "allOf": [{"if": {"required": ["feedback_target"]}, "then": {"required": ["role"], "properties": {"role": {"const": "feedback"}}}}]
      },
      "x-uniqueBy": "uri"
    },
    "techniques": {
      "type": "array",
      "maxItems": 8,
      "x-maxSelectedTechniques": 16,
      "x-uniqueBy": "pack_id",
      "description": "Optional explicit selection from bundled technique packs. Absent or empty selects none; every selection binds the exact pack bytes and named techniques.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "pack_version", "pack_sha256", "technique_ids"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "pack_version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
          "pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "technique_ids": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
          }
        }
      }
    },
    "phase": {
      "enum": [
        "concept",
        "draft",
        "plan-scene",
        "reader-review",
        "continuity-review",
        "revise"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "writing"
          }
        }
      },
      "then": {
        "properties": {
          "materials": {
            "items": {
              "properties": {
                "purpose": {
                  "enum": [
                    "current-writing",
                    "world-projection"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "materials": {
            "items": {
              "properties": {
                "purpose": {
                  "const": "actor-projection"
                }
              },
              "not": {"required": ["feedback_target"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "world-action"
          }
        }
      },
      "then": {
        "allOf": [
          {"not": {"required": ["phase"]}},
          {"not": {"required": ["techniques"]}}
        ]
      }
    }
  ],
  "$comment": "Runtime semantic constraints are defined in docs/interface.md; shape validation alone is insufficient."
}
