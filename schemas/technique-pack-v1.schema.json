{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing Assistant bundled technique pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "pack_version", "title", "summary", "guidance", "phase_guidance", "techniques"],
  "x-maxUtf8Bytes": 65536,
  "properties": {
    "schema_version": {"const": "writing-assistant-technique-pack/1"},
    "pack_id": {"$ref": "#/$defs/id"},
    "pack_version": {"$ref": "#/$defs/version"},
    "title": {"$ref": "#/$defs/title"},
    "summary": {"$ref": "#/$defs/text1024"},
    "guidance": {"$ref": "#/$defs/text2048"},
    "phase_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "draft", "plan-scene", "reader-review", "continuity-review", "revise"],
      "properties": {
        "concept": {"$ref": "#/$defs/text2048"},
        "draft": {"$ref": "#/$defs/text2048"},
        "plan-scene": {"$ref": "#/$defs/text2048"},
        "reader-review": {"$ref": "#/$defs/text2048"},
        "continuity-review": {"$ref": "#/$defs/text2048"},
        "revise": {"$ref": "#/$defs/text2048"}
      }
    },
    "techniques": {
      "type": "array", "minItems": 1, "maxItems": 16, "x-uniqueBy": "technique_id",
      "items": {"$ref": "#/$defs/technique"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "text": {"type": "string", "minLength": 1, "allOf": [{"pattern": "\\S"}, {"not": {"pattern": "[\\u0000-\\u0008\\u000b-\\u001f]"}}]},
    "title": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 120, "x-maxUtf8Bytes": 120}]},
    "text1024": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 1024, "x-maxUtf8Bytes": 1024}]},
    "text2048": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 2048, "x-maxUtf8Bytes": 2048}]},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/text1024"}},
    "phase": {"enum": ["concept", "draft", "plan-scene", "reader-review", "continuity-review", "revise"]},
    "technique": {
      "type": "object", "additionalProperties": false,
      "required": ["technique_id", "title", "phases", "applies_when", "guidance", "limitations", "review_criteria"],
      "properties": {
        "technique_id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/title"},
        "phases": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/phase"}},
        "applies_when": {"$ref": "#/$defs/text2048"},
        "guidance": {"$ref": "#/$defs/text2048"},
        "limitations": {"$ref": "#/$defs/criteria"},
        "review_criteria": {"$ref": "#/$defs/criteria"},
        "applicability": {"$ref": "#/$defs/applicability"}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false, "required": ["tasks", "story_tags"],
      "properties": {
        "tasks": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "story_tags": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$comment": "Add a reviewed JSON file at technique_packs/PACK_ID/MAJOR.MINOR.PATCH.json inside the application package. Directory and filename must match the validated pack identity. Up to 32 versioned packs are discoverable. Request selections never specify paths or executable extensions. Runtime validation additionally enforces UTF-8 byte limits, unique identities, selection totals, phase applicability, and exact file digests."
}
