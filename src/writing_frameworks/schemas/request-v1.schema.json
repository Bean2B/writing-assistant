{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing producer request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "phase", "context", "request", "materials"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "selection": {"$ref": "#/$defs/selection"},
    "phase": {"enum": ["concept", "plan-scene", "draft", "reader-review", "continuity-review", "revise"]},
    "context": {"$ref": "#/$defs/context"},
    "request": {"type": "string", "maxLength": 1048576},
    "materials": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["version", "mode"],
      "properties": {"version": {"const": 1}, "mode": {"enum": ["lotus", "none"]}}
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["id", "fresh", "frameworks_seen"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "fresh": {"type": "boolean"},
        "frameworks_seen": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["uri", "sha256"],
      "properties": {"uri": {"type": "string", "minLength": 1, "maxLength": 2048}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  },
  "allOf": [{
    "if": {"required": ["selection"], "properties": {"selection": {"properties": {"mode": {"const": "none"}}}}},
    "then": {"properties": {"phase": {"enum": ["concept", "draft", "reader-review", "continuity-review"]}}}
  }],
  "$comment": "This is a producer transport contract, not a record/ID schema. Runtime also enforces nonblank identifiers, valid UTF-8, per-material 1 MiB and total 4 MiB byte limits and exact source hashes. Context is caller-declared, never authenticated by this schema."
}
